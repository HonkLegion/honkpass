<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The system starts the extension in a sandbox. It has no access to the Keychain of the app. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<!-- The names of the launch agent's services begin with this group, which lets the extension look them up. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)$(APP_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
